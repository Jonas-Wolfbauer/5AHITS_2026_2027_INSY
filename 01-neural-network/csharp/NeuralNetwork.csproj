<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NeuralNetworkFromScratch</RootNamespace>
    <AssemblyName>NeuralNetwork</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Numbers always use "." as decimal separator, whatever the Windows region says -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Checks the .editorconfig rules (braces, field names) on every build -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
